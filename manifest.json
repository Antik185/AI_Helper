{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "activeTab",
    "downloads",
    "windows",
    "notifications",
    "contextMenus",
    "cookies",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://discord.com/*",
    "https://canary.discord.com/*",
    "https://ptb.discord.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.googleapis.com/*",
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://openrouter.ai/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["chatgpt-proxy.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://discord.com/*",
        "https://canary.discord.com/*",
        "https://ptb.discord.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["x-content.js"],
      "css": ["x-content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "https://discord.com/*",
        "https://canary.discord.com/*",
        "https://ptb.discord.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["universal-content.js", "ai-chat.js"],
      "css": ["universal-content.css", "ai-chat.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["_locales/*"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": [
        "animated/son/*.png",
        "animated/son/*.webm",
        "animated/kopaet/*.png",
        "animated/kopaet/*.webm"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "discord-translate-helper@local",
      "strict_min_version": "121.0"
    }
  }
}
